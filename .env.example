# Copie para .env e preencha com os dados do SEU ambiente. Nunca suba o .env para o GitHub
# (o .gitignore já o ignora).

# ─── Jira (obrigatório) ──────────────────────────────────────────────────────────────────
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=seu.email@suaempresa.com.br
JIRA_API_TOKEN=COLE_SEU_TOKEN_AQUI
JIRA_BASE_URL=https://SEU-SITE.atlassian.net

# Dono da fila: recebe os tickets NÃO EXECUTÁVEIS (ver manual/docs/fluxo-jira.md)
AGENT_OWNER_EMAIL=dono.da.fila@suaempresa.com.br

# ─── Jira (opcional) ─────────────────────────────────────────────────────────────────────
# Projeto e tipo padrão para criar cards
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Task
# Acessar pelo gateway da Atlassian em vez da URL direta
# JIRA_CLOUD_ID=

# Campos customizados: todos OPCIONAIS. Cada Jira tem os seus IDs (customfield_NNNNN). Para achar:
# Configurações do Jira → Issues → Campos personalizados → abra o campo e veja o número na URL.
# Sem o ID, o recurso que usa o campo é pulado.
# Categoria exigida pelo board para o card andar no fluxo (só se o seu board pedir):
# JIRA_CATEGORIA_FIELD=customfield_NNNNN
# JIRA_CATEGORIA_VALOR=Nome exato de uma opção do campo
# Campo "Dev responsável pelo bug" (ajuda a decidir para quem devolver o reprovado):
# JIRA_DEV_RESPONSAVEL_FIELD=customfield_NNNNN
# Campo multiusuário "QAs" (quem está testando/automatizando):
# JIRA_QAS_FIELD=customfield_NNNNN
# Campo de casos de teste (se um painel de QA lê os testes de lá):
# JIRA_CASOS_FIELD=customfield_NNNNN
# Label e tipo do defeito aberto pela automação:
# JIRA_LABEL_BUG=bug-automacao
# JIRA_TIPO_DEFEITO=triagem

# Ordem dos status do seu board (usada para andar o card status a status), separados por vírgula
# JIRA_TRILHO=ANALISAR,ANALISANDO,FILA DESENVOLVIMENTO,IMPLEMENTANDO,AGUARDANDO MERGE,VERSAO,FINALIZADO

# ─── Repositórios (opcional) ─────────────────────────────────────────────────────────────
# Só se os PRs estiverem no GitLab (no GitHub, basta o `gh auth login`)
# GITLAB_TOKEN=

# ─── Zendesk (opcional) ──────────────────────────────────────────────────────────────────
# Base dos artigos da central de ajuda citados nos cards
# ZENDESK_ARTICLES_URL=https://SEU-DOMINIO.zendesk.com/hc/pt-br/articles/
